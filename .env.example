# PreAuth Agent configuration (prefix PA_)
PA_ENVIRONMENT=local
# Rationale writing: "template" needs no LLM; "llm" uses the provider cascade.
PA_RATIONALE_MODE=template
PA_LLM_PROVIDERS=anthropic,openai,gemini,deepseek,ollama
# Set keys only for the providers you use. Ollama is local and needs no key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_HOST=http://localhost:11434
